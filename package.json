{
  "name": "@quality-sh/postui",
  "version": "0.0.2",
  "description": "The terminal postman. Import curl, get structured requests, generate integration tests.",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "postui": "dist/postui.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "effect:check": "bun scripts/check-effect-diagnostics.mjs",
    "lint": "oxlint --config .oxlintrc.json",
    "knip": "knip",
    "audit": "bun audit --audit-level=high",
    "check": "bun run typecheck && bun run effect:check && bun run lint && bun run knip && bun run audit && bun test",
    "build": "bun build src/cli.ts --target=bun --external @opentui/core --outfile dist/postui.js",
    "prepublishOnly": "bun run check && bun run build"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quality-sh/postui.git"
  },
  "devDependencies": {
    "@effect/language-service": "^0.87.2",
    "@quality-sh/provenance": "^0.2.1",
    "@types/bun": "^1.3.0",
    "knip": "^6.32.3",
    "oxlint": "^1.80.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@opentui/core": "0.5.9",
    "effect": "^4.0.0-rc.112"
  }
}